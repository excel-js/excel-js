{
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "u": "bun --sequential format build test:bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "build": "bun run --parallel --filter='./packages/**' build",
    "test:bun": "bun run --filter='./packages/**' test:bun",
    "test": "bun run --filter='./packages/**' test"
  },
  "devDependencies": {
    "@gameroman/config": "0.2.9",
    "@types/node": "26.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
